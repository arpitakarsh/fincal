generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
// AUTH & USER SETTINGS (Better Auth)
// ----------------------------------------------------------------------------

model User {
  id            String   @id @default(uuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  accounts          Account[]
  sessions          Session[]
  preferences       UserPreferences?
  investorProfile   InvestorProfile?
  portfolio         Portfolio?
  goals             Goal[]
  aiInsights        AIInsightHistory[]
  aiRecommendations AIRecommendation[]
}

model Session {
  id        String   @id @default(uuid())
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id @default(uuid())
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model UserPreferences {
  id          String   @id @default(uuid())
  theme       String   @default("system")
  currency    String   @default("INR")
  emailAlerts Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ----------------------------------------------------------------------------
// INVESTOR & PORTFOLIO
// ----------------------------------------------------------------------------

model InvestorProfile {
  id                   String   @id @default(uuid())
  age                  Int
  currentCapital       Float
  monthlyInvestmentCap Float
  existingSip          Float
  existingLumpsum      Float
  emergencyFund        Float
  annualIncome         Float?
  goalType             String
  targetAmount         Float?
  targetYear           Int
  riskAppetite         String
  investmentKnowledge  String
  liquidityPreference  String
  investmentStyle      String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Portfolio {
  id              String   @id @default(uuid())
  totalInvested   Float    @default(0)
  currentValue    Float    @default(0)
  totalMonthlySip Float    @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  holdings  UserHolding[]
  snapshots PortfolioSnapshot[]
}

model UserHolding {
  id               String   @id @default(uuid())
  fundId           String?
  fundName         String?
  schemeCode       String?
  units            Float
  averageNav       Float
  investedValue    Float
  currentValue     Float?
  source           String?
  recommendationId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  portfolioId String
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@index([portfolioId])
  @@index([schemeCode])
}

model PortfolioSnapshot {
  id          String   @id @default(uuid())
  date        DateTime @default(now())
  totalValue  Float
  netInvested Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  portfolioId String
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@index([portfolioId])
}

// ----------------------------------------------------------------------------
// GOALS & RECOMMENDATIONS
// ----------------------------------------------------------------------------

enum InvestmentType {
  lumpsum
  sip
}

enum GoalType {
  wealth_generation
  education
  retirement
  house
  other
}

enum RiskAppetiteGoal {
  low
  moderate
  high
}

model Goal {
  id                String           @id @default(uuid())
  name              String?
  investmentType    InvestmentType
  lumpsumAmount     Float?
  sipAmount         Float?
  targetAmount      Float
  timeHorizonYears  Float
  isFlexibleHorizon Boolean          @default(false)
  goalType          GoalType
  riskAppetite      RiskAppetiteGoal
  age               Int
  additionalNotes   String?          @db.Text
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  progressSnapshots GoalProgress[]
  aiRecommendations AIRecommendation[]

  @@index([userId])
}

model GoalProgress {
  id         String   @id @default(uuid())
  date       DateTime @default(now())
  amount     Float
  percentage Float
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  goalId String
  goal   Goal   @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId])
}

model AIRecommendation {
  id                         String   @id @default(uuid())
  schemeCode                 String
  fundName                   String
  category                   String
  score                      Float
  reason                     String   @db.Text
  suggestedAllocationPercent Float
  addedToPortfolio           Boolean  @default(false)
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  goalId String
  goal   Goal   @relation(fields: [goalId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([goalId])
  @@index([userId])
}

model AIInsightHistory {
  id        String   @id @default(uuid())
  topic     String
  insight   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ----------------------------------------------------------------------------
// LATEST NAV CACHE (PostgreSQL — one row per scheme, updated daily)
//
// Purpose: Persistent latest-NAV store so the application does NOT need to
// call mfapi.in or AMFI on every user request.  A daily ingest job UPSERTs
// each scheme's current NAV.  There is exactly ONE row per schemeCode — the
// same row is overwritten on each ingest run.
//
// What is NOT stored here:
//   - Historical NAV series (those are fetched from mfapi on demand + Redis 24h)
//   - Full AMFI universe metadata (that uses Redis 12h)
// ----------------------------------------------------------------------------
model LatestNAV {
  /// AMFI/mfapi scheme code — uniquely identifies a mutual fund scheme.
  schemeCode String   @id

  schemeName String   @default("")
  /// NAV value as of navDate.  Stored as Float, consistent with other
  /// monetary fields in this schema.  Always > 0 when persisted.
  nav        Float
  /// Date string in the format returned by the data source (DD-MMM-YYYY from
  /// AMFI, or DD-MM-YYYY from mfapi).  Stored as a string to avoid timezone
  /// ambiguity; we never query by date range so DateTime adds no benefit.
  navDate    String   @default("")
  amc        String   @default("")
  category   String   @default("")
  /// Automatically updated by Prisma whenever the row is written.
  updatedAt  DateTime @updatedAt
}

